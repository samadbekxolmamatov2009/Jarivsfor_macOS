# /etc/jarvis-lite.env  — sozlamalar. Bu faylni FAQAT o'zingiz ko'rasiz (chmod 600), hech kimga yubormang.
# Telegram: https://my.telegram.org → API development tools (Mac'dagi Jarvis config.py da shular allaqachon bor)
TG_API_ID=
TG_API_HASH=
# Claude: console.anthropic.com → API Keys  (bo'sh qoldirsangiz tayyor jumlalar yuboriladi, mazmunni tushunmaydi)
ANTHROPIC_API_KEY=
OWNER_NAME=Zufarbek
OWNER_FULL_NAME=Zufarbek Jumayev
# Ixtiyoriy
# AUTOREPLY_MODEL=claude-sonnet-5-5      (arzonroq: claude-haiku-5-5)
# AUTOREPLY_LANG=auto                    (auto | en | llm)
# GRACE_SECONDS=240                      (javob berishdan oldin kutish, soniyada: 240 = 4 daqiqa; shu orada o'zingiz yozsangiz bot jim turadi)
# Telefonga bildirishnoma (faqat zarur paytda): Jarvis botingiz tokeni. Chat id kerak emas (botda bir marta Start bosing).
# NOTIFY_BOT_TOKEN=
# NOTIFY_ALL_REPLIES=1                   (har bir javob nusxasi ham kelsin desangiz)
DATA_DIR=/var/lib/jarvis-lite
