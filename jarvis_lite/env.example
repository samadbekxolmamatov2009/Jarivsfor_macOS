# /etc/jarvis-lite.env  — sozlamalar. Bu faylni FAQAT o'zingiz ko'rasiz (chmod 600), hech kimga yubormang.
# Telegram: https://my.telegram.org → API development tools (Mac'dagi Jarvis config.py da shular allaqachon bor)
TG_API_ID=
TG_API_HASH=
# Claude: console.anthropic.com → API Keys  (bo'sh qoldirsangiz tayyor jumlalar yuboriladi, mazmunni tushunmaydi)
ANTHROPIC_API_KEY=
OWNER_NAME=Zufarbek
OWNER_FULL_NAME=Zufarbek Jumayev
# Ixtiyoriy
# AUTOREPLY_MODEL=claude-haiku-5-5       (tayyor; o'zbekchasi yaxshiroq bo'lsin desangiz: claude-sonnet-5-5, ~20 baravar qimmatroq)
# AUTOREPLY_LANG=auto                    (auto | en | llm)
# GRACE_SECONDS=900                      (javob berishdan oldin kutish, soniyada: 900 = 15 daqiqa; shu orada o'zingiz yozsangiz bot jim turadi)
# BUSY_HOURS=mon,wed,fri 16:00-18:00; tue,thu,sat 17:00-19:30     (siz BAND bo'lgan vaqtlar: shu paytda darrov «band» deydi; 'off' = jadvalsiz)
# TZ_OFFSET=5                            (vaqt mintaqasi: UTC dan soat; O'zbekiston = 5)
# Telefonga bildirishnoma (faqat zarur paytda): Jarvis botingiz tokeni. Chat id kerak emas (botda bir marta Start bosing).
# NOTIFY_BOT_TOKEN=
# REMIND_MINUTES=30                      (muhim xabarga javob bermasangiz, necha daqiqadan keyin eslatsin)
# REMIND_TIMES=2                         (ko'pi bilan necha marta eslatsin)
# NOTIFY_ALL_REPLIES=1                   (har bir javob nusxasi ham kelsin desangiz)
# Baza (Render uchun Turso): rejalashtirilgan xabarlar va holat qayta joylashda yo'qolmasligi uchun.
# TURSO_DATABASE_URL=libsql://baza-nomi-sizning-nomingiz.turso.io
# TURSO_AUTH_TOKEN=
DATA_DIR=/var/lib/jarvis-lite
